AUTH_MODE=local
LOCAL_USER_EMAIL=owner@xxxignal.local
LOCAL_USER_NAME=Owner

# Phase 3 AI Provider
# template: 外部APIを使わない0円モード（既定）
# openai: OPENAI_API_KEY / OPENAI_MODELを設定した時だけ外部APIを呼びます
AI_PROVIDER=template
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Phase 4 X OAuth
# X_CLIENT_ID=
# X_CLIENT_SECRET=
# X_REDIRECT_URI=http://localhost:5173/api/x/oauth/callback
# 32 byte random key encoded as Base64. Never commit the real value.
# X_TOKEN_ENCRYPTION_KEY=
X_SCOPES=tweet.read users.read offline.access

